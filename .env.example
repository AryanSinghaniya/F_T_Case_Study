# LLM Provider Configuration
# Set LLM_PROVIDER to: groq | gemini | ollama | none

# Option 1: Groq (Recommended - Fast & Free tier at console.groq.com)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative Groq models: llama-3.1-8b-instant, mixtral-8x7b-32768

# Option 2: Google Gemini (Free tier at aistudio.google.com)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Option 3: Local Ollama (Local open weights)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2

# Option 4: Deterministic Fallback (No LLM, template-based)
# LLM_PROVIDER=none
